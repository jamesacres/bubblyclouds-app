{
  "name": "bubblyclouds-app",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "author": "James Acres",
  "description": "Bubbly Clouds App",
  "engines": {
    "node": ">=24",
    "npm": "please-use-pnpm",
    "pnpm": ">=10"
  },
  "scripts": {
    "preinstall": "npx only-allow@1.2.2 pnpm",
    "dev": "turbo run dev",
    "dev:bubblyclouds": "turbo run dev --filter=@bubblyclouds-app/app-bubblyclouds",
    "dev:sudoku": "turbo run dev --filter=@bubblyclouds-app/app-sudoku",
    "dev:unblockrace": "turbo run dev --filter=@bubblyclouds-app/app-unblockrace",
    "dev:moneybagsrace": "turbo run dev --filter=@bubblyclouds-app/app-moneybagsrace",
    "dev:jamesacres": "turbo run dev --filter=@bubblyclouds-app/app-jamesacres",
    "dev:stephenesch": "turbo run dev --filter=@bubblyclouds-app/app-stephenesch",
    "build": "turbo run build",
    "build:bubblyclouds": "turbo run build --filter=@bubblyclouds-app/app-bubblyclouds",
    "build:sudoku": "turbo run build --filter=@bubblyclouds-app/app-sudoku",
    "build:unblockrace": "turbo run build --filter=@bubblyclouds-app/app-unblockrace",
    "build:moneybagsrace": "turbo run build --filter=@bubblyclouds-app/app-moneybagsrace",
    "build:jamesacres": "turbo run build --filter=@bubblyclouds-app/app-jamesacres",
    "build:stephenesch": "turbo run build --filter=@bubblyclouds-app/app-stephenesch",
    "build:sudoku:capacitor": ". ./scripts/buildCapacitor.sh sudoku",
    "build:sudoku:electron": "./scripts/buildElectron.sh sudoku",
    "build:unblockrace:capacitor": ". ./scripts/buildCapacitor.sh unblockrace",
    "build:unblockrace:electron": "./scripts/buildElectron.sh unblockrace",
    "build:moneybagsrace:capacitor": ". ./scripts/buildCapacitor.sh moneybagsrace",
    "build:moneybagsrace:electron": "./scripts/buildElectron.sh moneybagsrace",
    "build:template": "turbo run build --filter=@bubblyclouds-app/app-template",
    "build:template:capacitor": ". ./scripts/buildCapacitor.sh template",
    "build:template:electron": "./scripts/buildElectron.sh template",
    "type-check": "turbo run type-check",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "serve:bubblyclouds": "npx serve apps/bubblyclouds/out",
    "serve:sudoku": "npx serve apps/sudoku/out",
    "serve:unblockrace": "npx serve apps/unblockrace/out",
    "serve:moneybagsrace": "npx serve apps/moneybagsrace/out",
    "serve:jamesacres": "npx serve apps/jamesacres/out",
    "serve:stephenesch": "npx serve apps/stephenesch/out",
    "test": "turbo run test",
    "test:watch": "turbo run test -- --watch",
    "test:coverage": "turbo run test -- --coverage",
    "test:ci": "turbo run test -- --coverage --ci --maxWorkers=2",
    "circular": "turbo run circular",
    "manypkg": "manypkg check",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^9.39.4",
    "@manypkg/cli": "^0.25.1",
    "@next/eslint-plugin-next": "^16.2.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "enquirer": "^2.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "madge": "^8.0.0",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "root": "^3.2.0",
    "turbo": "^2.9.4"
  }
}