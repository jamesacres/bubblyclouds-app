{
  "name": "bubblyclouds-app",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "author": "James Acres",
  "description": "Bubbly Clouds App",
  "engines": {
    "node": ">=24",
    "npm": "please-use-pnpm",
    "pnpm": ">=10"
  },
  "scripts": {
    "preinstall": "npx only-allow@1.2.2 pnpm",
    "dev": "turbo run dev",
    "dev:sudoku": "turbo run dev --filter=@bubblyclouds-app/app-sudoku",
    "dev:template": "turbo run dev --filter=@bubblyclouds-app/app-template",
    "build": "turbo run build",
    "build:sudoku": "turbo run build --filter=@bubblyclouds-app/app-sudoku",
    "build:sudoku:capacitor": ". ./scripts/buildCapacitor.sh sudoku",
    "build:sudoku:electron": "./scripts/buildElectron.sh sudoku",
    "build:template": "turbo run build --filter=@bubblyclouds-app/app-template",
    "build:template:capacitor": ". ./scripts/buildCapacitor.sh template",
    "build:template:electron": "./scripts/buildElectron.sh template",
    "type-check": "turbo run type-check",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "test": "turbo run test",
    "test:watch": "turbo run test -- --watch",
    "test:coverage": "turbo run test -- --coverage",
    "test:ci": "turbo run test -- --coverage --ci --maxWorkers=2",
    "circular": "turbo run circular",
    "manypkg": "manypkg check",
    "generate:icons": "npx @capacitor/assets generate --iconBackgroundColor '#eeeeee' --iconBackgroundColorDark '#222222' --splashBackgroundColor '#eeeeee' --splashBackgroundColorDark '#111111'",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.39.2",
    "@manypkg/cli": "^0.25.1",
    "@next/eslint-plugin-next": "^16.1.1",
    "@typescript-eslint/eslint-plugin": "^8.50.1",
    "@typescript-eslint/parser": "^8.52.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.0.0",
    "husky": "^9.1.7",
    "madge": "^8.0.0",
    "prettier": "^3.2.5",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "root": "^3.2.0",
    "turbo": "^2.7.3"
  }
}