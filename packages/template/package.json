{
  "name": "@bubblyclouds-app/template",
  "version": "0.1.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./components/*": "./src/components/*.tsx",
    "./providers/*": "./src/providers/*.tsx",
    "./hooks/*": "./src/hooks/*.ts",
    "./helpers/*": "./src/helpers/*.ts",
    "./config/*": [
      "./src/config/*.ts",
      "./src/config/*.tsx"
    ],
    "./services/*": "./src/services/*.ts",
    "./types/*": "./src/types/*.ts",
    "./utils/*": "./src/utils/*.ts"
  },
  "scripts": {
    "build": "echo 'Template package is pure TypeScript - no compilation needed'",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "jest",
    "circular": "madge --circular --extensions ts,tsx src/"
  },
  "dependencies": {
    "@bubblyclouds-app/auth": "workspace:*",
    "@bubblyclouds-app/types": "workspace:*",
    "@bubblyclouds-app/ui": "workspace:*",
    "@capacitor/app": "^8.1.0",
    "@capacitor/browser": "^8.0.3",
    "@capacitor/core": "^8.3.1",
    "@capacitor/status-bar": "^8.0.2",
    "@headlessui/react": "^2.2.9",
    "@revenuecat/purchases-capacitor": "^12.3.1",
    "@revenuecat/purchases-js": "^1.30.0",
    "capacitor-secure-storage-plugin": "^0.13.0",
    "lucide-react": "^0.563.0",
    "next": "^16.2.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.3.0",
    "jest-environment-node": "^29.7.0",
    "prettier": "^3.8.1",
    "ts-jest": "^29.4.9",
    "typescript": "^5.9.3"
  }
}