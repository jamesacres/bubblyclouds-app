    },
    "maple": {
      "name": "Maple",
      "emojiName": "rakun",
      "personality": "Gigih dan oportunis. Ritmenya tak beraturan. Di akhir, menemukan momentum dan meluncur keluar lebih cepat dari dugaan.",
      "voiceLines": {
        "neutral": ["Itu menggesernya!", "Agak sempit, tapi lumayan."],
        "playerAhead": ["Baik, saatnya mendorong.", "Belum terkurung."],
        "playerBehind": ["Oh—celah bagus.", "Jalurnya mulai terbuka sekarang."],
        "endgame": ["Yap, jalan di depan lapang.", "Sekarang melaju."]
      }
    },
    "compass": {
      "name": "Compass",
      "emojiName": "pinguin",
      "personality": "Terstruktur dan metodis. Kecepatan konsisten. Di akhir tetap tenang — tanpa panik, tanpa kebut-kebutan.",
      "voiceLines": {
        "neutral": ["Geseran itu sesuai rute.", "Tetap konsisten."],
