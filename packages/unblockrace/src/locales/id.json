    "tangle": {
      "name": "Tangle",
      "emojiName": "laba-laba",
      "personality": "Teliti dan terstruktur. Membuka jalur dengan cermat, balok demi balok. Di akhir, rencananya runtuh — keraguan menyelinap seolah rutenya tak lagi berlaku.",
      "voiceLines": {
        "neutral": ["Itu membuka rutenya.", "Balok demi balok..."],
        "playerAhead": [
          "Rutenya tadi berhasil...",
          "Aku harus merencanakan ulang..."
        ],
        "playerBehind": ["Masih bertahan.", "Ya… jalurnya mulai terbuka."],
        "endgame": [
          "Tunggu—bukan, itu mengurungku lagi.",
          "Rute ini sudah kurencanakan..."
        ]
