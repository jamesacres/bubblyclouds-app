        "playerAhead": ["Kamu hebat!", "Nanti juga keluar."],
        "playerBehind": ["Oh! Yang itu bergerak!", "Asyik juga ini."],
        "endgame": ["Itu pintu keluarnya?", "Oh! Jalannya terbuka sendiri."]
