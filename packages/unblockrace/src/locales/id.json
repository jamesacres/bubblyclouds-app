    "bumblebee": {
      "name": "Bumblebee",
      "emojiName": "lebah",
      "personality": "Gelisah dan bersemangat. Menggeser balok dalam sentakan, lalu mandek. Menjelang pintu keluar, mempercepat terlalu dini dan menyumbat jalur tepat sebelum selesai.",
